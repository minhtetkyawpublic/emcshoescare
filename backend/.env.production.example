APP_NAME="EMC Shoes Care Myanmar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://k2softwarestudio.com/emcshoescare

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u608908096_your_database
DB_USERNAME=u608908096_your_user
DB_PASSWORD=replace-with-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_COOKIE=emc_shoes_session
# Fallback for CLI; web requests auto-detect the deployed public folder.
SESSION_PATH=/emcshoescare/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

EMC_ALLOWED_ORIGINS=https://k2softwarestudio.com
EMC_UPLOAD_MAX_BYTES=5242880
EMC_ORDER_PHOTO_RETENTION_DAYS=0
