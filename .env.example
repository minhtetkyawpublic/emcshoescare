# Plain PHP API configuration. Set these as server environment variables in production.
EMC_APP_ENV=development
EMC_APP_KEY=replace-with-at-least-32-random-characters
EMC_DB_HOST=127.0.0.1
EMC_DB_PORT=3306
EMC_DB_NAME=emc_shoes_care
EMC_DB_USER=root
EMC_DB_PASS=
EMC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMC_COOKIE_NAME=emc_session
EMC_COOKIE_PATH=/
EMC_SESSION_DAYS=30
EMC_ADMIN_COOKIE_NAME=emc_admin_session
EMC_UPLOAD_MAX_BYTES=5242880
# 0 disables deletion until the shop approves a policy; use at least 30 when enabled.
EMC_ORDER_PHOTO_RETENTION_DAYS=0
